# ---- Required ----
# Netlify Database sets NETLIFY_DB_URL automatically. For any other Postgres use DATABASE_URL.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# 32+ random characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=
# Public URL of the site (used for Paystack redirects and origin checks)
SITE_URL=https://your-site.netlify.app
# Comma-separated emails that become admins when they register/log in
ADMIN_EMAILS=you@example.com

# ---- Paystack (deposits / withdrawals) ----
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx
# true = admin "Approve & pay" sends money via Paystack Transfers (needs a verified business)
PAYSTACK_TRANSFERS_ENABLED=false
# true = only accept webhooks from Paystack's published IPs
PAYSTACK_ENFORCE_IPS=true

# ---- The Odds API (fixtures + odds) ----
ODDS_API_KEY=
# 'all' = every in-season league; or a comma list of league keys
ODDS_API_SPORTS=all
# Optional: only these sport groups
# ODDS_API_GROUPS=soccer,basketball
# Bookmaker regions used for consensus pricing (us,uk,eu,au). Each region multiplies credit cost.
ODDS_API_REGIONS=eu
# Max API credits to spend per day (free plan = 500/month => ~15/day)
ODDS_DAILY_CREDIT_BUDGET=15
# Stop syncing when this many monthly credits remain
ODDS_CREDIT_RESERVE=10
# House margin applied to consensus odds (0.05 = 5%)
ODDS_MARGIN=0.05
# Settle Match Result markets automatically from official scores
ODDS_AUTO_SETTLE=true
# Minimum minutes between feed syncs (controls API credit usage)
ODDS_SYNC_INTERVAL_MINUTES=60

# ---- Optional ----
# SESSION_TTL_HOURS=168
# SESSION_IDLE_MINUTES=720
# REQUIRE_ADMIN_2FA=true
# Local development over http only:
# INSECURE_COOKIES=1
